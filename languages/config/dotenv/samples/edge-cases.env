EMPTY=
COMMENT=value # comment
HASH=value#literal
SPACES=some text   
EXPAND=${NAME}-$NAME
QUOTED="a # b" # comment
LEADING_HASH=#literal
COMMENT_ONLY= # comment
NO_EXPAND='${HOME}'
DEFAULT=${A:-${B-default}}
REQUIRED=${A:?missing} ${B?err}
ALTERNATE=${A:+yes} ${B+alt}
SINGLE='escaped \' quote and $LITERAL'
